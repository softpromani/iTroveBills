# Turn off directory indexing and CGI execution
Options -Indexes -ExecCGI

# Deny web execution or access to executable, script, or configuration files
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|phps|inc|pl|py|cgi|asp|aspx|sh|bash|exe|bat|cmd|dll|htaccess|htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable PHP execution engine across all PHP module versions
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
